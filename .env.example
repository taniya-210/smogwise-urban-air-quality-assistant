# GEMINI_API_KEY: Required for Gemini AI recommendations, routine planning, and assistant chat.
# Configured server-side only (never exposed to the browser).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# WAQI_API_TOKEN: Optional World Air Quality Index (aqicn.org) token for ground monitoring station readings.
# When omitted, SmogWise uses Open-Meteo Air Quality (CAMS assimilated atmospheric data) with clear source labeling.
WAQI_API_TOKEN=""

# PORT: Server port (defaults to 3000)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
