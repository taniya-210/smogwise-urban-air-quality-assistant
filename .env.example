# GEMINI_API_KEY: Required for server-side Gemini AI recommendations, routine planning, and assistant chat.
# Configured server-side only (never exposed to the browser or prefixed with VITE_).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the Gemini model name (defaults to gemini-2.5-flash).
GEMINI_MODEL="gemini-2.5-flash"

# WAQI_API_TOKEN: Optional World Air Quality Index (aqicn.org) token for ground monitoring station readings.
# When omitted, SmogWise uses Open-Meteo Air Quality (CAMS assimilated atmospheric data) with clear source labeling.
WAQI_API_TOKEN=""

# RATE_LIMIT_MAX_REQUESTS: Maximum AI API requests per IP within the rate-limit window (default: 10).
RATE_LIMIT_MAX_REQUESTS="10"

# RATE_LIMIT_WINDOW_MS: Rate-limit window duration in milliseconds (default: 60000 = 1 minute).
RATE_LIMIT_WINDOW_MS="60000"

# PORT: Server port (defaults to 3000)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
